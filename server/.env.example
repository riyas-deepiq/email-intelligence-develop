# ─────────────────────────────────────────────────────────────────────────────
# Insight Hub — Core Server environment
# Copy this file to `.env` and adjust. Every variable is validated at startup by
# src/config/env.ts (Zod) — the process exits if a value is missing or outside the
# allowed set documented below.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode.
#   Possible values: development | test | production
#   Effect: 'development' enables pretty logs; 'test' forces silent logs.
#   Default: development
NODE_ENV=development

# HTTP port the server listens on.
#   Possible values: any positive integer (1–65535)
#   Port map for this project: server 3000 · probe 3001 · client 8080
#   Default: 3000
PORT=3000

# Log verbosity (Pino). Listed most→least severe.
#   Possible values: fatal | error | warn | info | debug | trace | silent
#   Note: NODE_ENV=test always logs at 'silent', ignoring this value.
#   Default: info
LOG_LEVEL=info

# Allowed CORS origin for the browser client.
#   Possible values: a single origin URL (e.g. http://localhost:8080)
#                    | *  (allow any origin — not recommended with credentials)
#   Default: http://localhost:8080  (the Client/ dev server)
CORS_ORIGIN=http://localhost:8080

# Which user-repository backend to use.
#   Possible values: postgres | memory
#   'memory' needs no database and is always used by tests; use 'postgres' for real runs.
#   Default: postgres
DB_DRIVER=postgres

# PostgreSQL connection string.
# The server connects to the built-in "postgres" maintenance DB on startup using
# these same credentials to auto-create the app database if it doesn't exist yet.
# The DB user must have CREATEDB privilege (the default "postgres" superuser does).
#   Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/insight_hub

# JWT signing secret. Must be at least 32 characters. Use a long random value in production.
#   Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-min-32-chars!!

# Access token lifetime (jsonwebtoken format: '15m', '1h', '2h').
#   Default: 15m
JWT_EXPIRES_IN=15m

# Refresh token lifetime in seconds.
#   Default: 604800 (7 days)
REFRESH_TOKEN_TTL_SEC=604800

# AES-256-GCM key used to encrypt stored OAuth client secrets (auth providers).
# Must be a 64-character lowercase hex string (32 bytes). The placeholder below
# is REJECTED at startup when NODE_ENV=production — you must set a real one.
#   Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OIDC_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Redis connection URL. When unset the server uses an in-memory session store (dev / test only).
#   Possible values: redis://localhost:6379 | redis://:password@host:6379
#   Leave unset to run without Redis (not suitable for production).
# REDIS_URL=redis://localhost:6379

# Default Super Admin created automatically on first startup (if no superadmin exists).
#   Change these before going to production. The user will be prompted to change the
#   password after first login (onboarding wizard — Phase B).
SEED_ADMIN_EMAIL=admin@insight-hub.local
SEED_ADMIN_PASSWORD=Admin@1234!

# Collector service — internal HTTP URL of the Collector worker process.
#   When COLLECTOR_URL is unset the server works normally; probe/sync triggers are
#   skipped with a debug log (useful for running the server alone in development).
#   Set COLLECTOR_SECRET to the same value configured in the collector's .env.
# COLLECTOR_URL=http://localhost:3001
# COLLECTOR_SECRET=dev-collector-secret

# Ollama — local LLM used for AI thread summaries. Same instance the RAG
# service uses (see RAG/.env's OLLAMA_MODEL — keep both in sync so you're not
# running two different models). When unreachable, summary endpoints return
# 503 and the client falls back to derived thread facts.
#   Default: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
#   Must be a model you've actually pulled (`ollama list`). Default: llama3.2
OLLAMA_MODEL=llama3.2
#   Request timeout in milliseconds. Default: 120000 (2 min)
OLLAMA_TIMEOUT_MS=120000

# RAG service — internal HTTP URL of the Python RAG/FastAPI service that
# powers search and chat (server/src/modules/chat/). Required for the client's
# "Search Intelligence" page to work.
#   Default: http://127.0.0.1:8000
RAG_API_URL=http://127.0.0.1:8000
# Shared secret guarding RAG's /api/v1/query/* AND this server's own
# /v1/rag-internal/* (RAG fetching attachment bytes to vectorize) — must
# match RAG's RAG_INTERNAL_SECRET exactly when set. Leave unset for local dev
# (RAG enforces nothing when its own secret is unset; /v1/rag-internal/*
# returns 503 when this is unset).
# RAG_API_SECRET=

# SMTP email delivery — used to send the welcome notification after first-time org setup.
#   All fields are optional. When SMTP_HOST is unset, email is silently skipped (safe for dev/test).
#   For local dev, try Mailpit: https://mailpit.axllent.org (runs on :1025 / :8025)
#   For production, use your SMTP provider (Gmail, SendGrid relay, SES SMTP, etc.)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Insight Hub <noreply@yourdomain.com>
