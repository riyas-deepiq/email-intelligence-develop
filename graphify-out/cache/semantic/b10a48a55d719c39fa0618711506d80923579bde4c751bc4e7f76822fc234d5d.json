label": "Privacy-first / on-prem design principle", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No mail ever leaves the customer perimeter; the LLM runs locally on a dedicated AI node (MiPhi chip), self-hosted, with no cloud LLM APIs -- driven by enterprise data-sovereignty requirements."}, {"id": "readme_rag_not_training", "label": "RAG, not training -- design principle", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Knowledge lives in a vector database and is retrieved at query time, never baked into model weights, so it stays fresh, auditable, and deletable -- a trade-off favoring governance/compliance over fine-tuning."}, {"id": "readme_hierarchy_gated_access", "label": "Hierarchy-gated access -- enforced outside the model", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A manager can see their reports' mail, peers are isolated, the CEO sees everything -- enforced outside the model, in the database, so the LLM is never trusted as the access-control boundary."}, {"id": "readme_grounded_answers", "label": "Grounded answers -- strictly source-backed, always cited", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers are strictly source-backed and always cited, returning 'not found' when unsupported -- prioritizing auditability and trust over answer coverage."}], "edges": [{"source": "readme_project", "target": "readme_web_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.