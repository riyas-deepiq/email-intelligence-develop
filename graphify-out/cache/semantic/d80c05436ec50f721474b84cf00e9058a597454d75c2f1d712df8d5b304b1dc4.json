{"nodes": [{"id": "collector_readme_collector_service", "label": "Collector (ingestion service)", "file_type": "document", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as its own process, separate from the Core Server, because ingestion is bursty, long-running, and horizontally scalable \u2014 a heavy backfill never degrades the chat API, and the two scale independently, communicating only over network/queue, never in-process."}, {"id": "collector_readme_ingestion_service", "label": "IngestionService", "file_type": "code", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "collector_readme_mail_connector_interface", "label": "MailConnector interface", "file_type": "rationale", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connectors sit behind a MailConnector interface so the orchestrator never imports a provider SDK directly; Microsoft Graph and Gmail integrations can drop in during Phase 1 without touching orchestration or tests. Current stubs return no messages so the whole pipeline runs end-to-end with no credentials."}, {"id": "collector_readme_dedup_service", "label": "DedupService", "file_type": "rationale", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys on the immutable RFC Message-ID plus a content hash so re-runs never reprocess the same email; in-memory now, moving to a Postgres unique index in Phase 1."}, {"id": "collector_readme_scheduler", "label": "Scheduler (interval, no overlap)", "file_type": "rationale", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs incremental syncs on an interval and skips a tick if the previous run is still going, preventing overlapping/stacking sync runs."}, {"id": "collector_readme_split_into_batches", "label": "splitIntoBatches()", "file_type": "code", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "collector_readme_m365_connector_stub", "label": "M365Connector (stub)", "file_type": "code", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "collector_readme_google_connector_stub", "label": "GoogleConnector (stub)", "file_type": "code", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "collector_readme_minio_integration", "label": "MinIO raw storage (Phase 1)", "file_type": "concept", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "collector_readme_rabbitmq_integration", "label": "RabbitMQ job queue (Phase 1)", "file_type": "concept", "source_file": "collector/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "collector_readme_scheduler", "target": "collector_readme_ingestion_service", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "collector/README.md", "source_location": null, "weight": 1.0}, {"source": "collector_readme_ingestion_service", "target": "collector_readme_split_into_batches", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "collector/README.md", "source_location": null, "weight": 1.0}, {"source": "collector_readme_ingestion_service", "target": "collector_readme_mail_conne