d": "rag_readme_ingest_from_postgres_script", "label": "scripts/ingest_from_postgres.py", "file_type": "code", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_mailbox_scoped_rbac", "label": "Mailbox-scoped RBAC path", "file_type": "concept", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_department_role_rbac", "label": "Department/role-based RBAC path", "file_type": "concept", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_get_scoped_mailbox_ids", "label": "getScopedMailboxIds() (Core Server)", "file_type": "code", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_db_seed", "label": "db/seed.py", "file_type": "code", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_rag_internal_secret", "label": "RAG_INTERNAL_SECRET / RAG_API_SECRET shared secret", "file_type": "code", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_docker_compose_infra", "label": "docker-compose (Qdrant + Redis)", "file_type": "code", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_postgres_shared_db", "label": "Shared Postgres DB (Core Server + RAG)", "file_type": "concept", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_readme_incremental_cursor_rationale", "label": "Incremental ingestion cursor / fail-safe retry design", "file_type": "rationale", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If any message fails during a run, the sync cursor is not advanced at all; the next run retries the whole window from the same starting point. This is safe because re-ingesting an already-succeeded message just overwrites its Qdrant points rather than duplicating them."}, {"id": "rag_readme_concurrency_rationale", "label": "Thread-pool concurrency tied to OLLAMA_NUM_PARALLEL", "file_type": "rationale", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each email's chunk->embed->upsert step runs in a thread pool because the work is I/O-bound (HTTP calls to Ollama + Qdrant), so the GIL is released and threads give real speedup. Going much above Ollama's own OLLAMA_NUM_PARALLEL (default 4) just queues requests on Ollama's side without extra throughput, so --workers rarely needs to exceed that."}, {"id": "rag_readme_qdrant_filter_security_rationale", "label": "RBAC filtering enforced inside the Qdrant query", "file_type": "rationale", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtering happens inside the Qdrant query itself, so restricted chunks never leave the vector store, let alone reach the LLM -- access control is enforced structurally rather than trusted at the prompt/LLM layer."}, {"id": "rag_readme_postgres_only_backend_rationale", "label": "No SQLite fallback -- Postgres-only backend", "file_type": "rationale", "source_file": "RAG/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres is the only backend this system talks to, so pointing POSTGRES_URL at the Core Server's real database is not optional -- there is no lightweight local fallback path."}], "edges": [{"source": "rag_readme_project", "target": "rag_readme_ingestion_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_project", "target": "rag_readme_embedding_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_project", "target": "rag_readme_vector_store_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_project", "target": "rag_readme_retrieval_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_project", "target": "rag_readme_llm_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_project", "target": "rag_readme_db_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_project", "target": "rag_readme_api_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_ingestion_layer", "target": "rag_readme_pg_email_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_readme_ingestion_layer", "target": "rag_readme_eml_parser_manual", "relation": "ref