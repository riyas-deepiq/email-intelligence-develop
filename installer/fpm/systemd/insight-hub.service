# Insight Hub — server unit (native .deb / .rpm packaging).
#
# This file needs NO substitution and is shipped verbatim inside the package.
# That is the whole point of FHS paths: there is no install-time prefix to bake
# in, so the unit is a plain packaged file that dpkg/rpm can verify, diff and
# replace on upgrade — rather than a template rendered by an install script.

[Unit]
Description=Insight Hub server (REST API and web interface)
Documentation=file:/usr/share/doc/insight-hub-server/README.md
# network-online, not just network: the server opens a PostgreSQL connection on
# startup and exits if it cannot reach one.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=email-intel
Group=email-intel
WorkingDirectory=/var/lib/insight-hub

# How the binary finds its configuration. INSIGHT_HUB_CONFIG_DIR names a DIRECTORY that
# holds a file called .env — see server/src/config/env-file.ts.
Environment=INSIGHT_HUB_CONFIG_DIR=/etc/insight-hub/server
# Makes /etc/insight-hub/client/.env reachable by the browser as
# window.__INSIGHT_HUB_CONFIG__.
Environment=INSIGHT_HUB_CLIENT_CONFIG=/etc/insight-hub/client/.env

# Per-machine secrets, generated by the package's post-install script. The
# leading '-' means a missing file is not an error.
#
# These values WIN over anything in .env, because dotenv does not override
# variables that are already set in the environment. That is deliberate and it is
# what keeps generated secrets *out* of the dpkg/rpm-managed .env: the .env stays
# byte-identical to what the package shipped, so an upgrade never asks
# "Configuration file '/etc/...' has been modified — keep or replace?"
EnvironmentFile=-/etc/insight-hub/server/secrets.env

ExecStart=/usr/bin/insight-hub-server serve

# The server exits when PostgreSQL is unreachable. Restarting is right — the
# database usually comes back — but StartLimit stops a genuinely broken
# configuration from spinning forever and hiding the cause.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=6

# Journald captures stdout/stderr: `journalctl -u insight-hub`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=insight-hub

# ── Hardening ────────────────────────────────────────────────────────────────
# ReadWritePaths is the whitelist that ProtectSystem=strict punches through:
# everything else on disk is read-only to this process, /etc included.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/insight-hub /var/log/insight-hub

[Install]
WantedBy=multi-user.target
