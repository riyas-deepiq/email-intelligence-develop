# ============================================================================
# Insight Hub — COLLECTOR configuration  (.deb / .rpm, instance 1)
#
# Installed to:  /etc/insight-hub/collector1/.env
# Restart after editing:
#     sudo systemctl restart insight-hub-collector@1
#
# A package configuration file: your edits survive upgrades (dpkg conffile /
# rpm %config(noreplace)).
#
# ── WHERE IS COLLECTOR_SECRET? ───────────────────────────────────────────────
# In /etc/insight-hub/collector1/secrets.env, written at install time and
# loaded by the unit with EnvironmentFile=. It holds SERVER_URL and
# COLLECTOR_SECRET, and both win over whatever this file says.
#
# The secret is never invented. It has to match the server's byte for byte, and
# a fabricated value produces a collector that polls, is rejected 401, and looks
# perfectly healthy from outside. The post-install script takes it from a server
# installed on this machine, or from a join file, or leaves it unset and says so.
#
# ── RUNNING MORE COLLECTORS ──────────────────────────────────────────────────
# Throughput scales by adding instances. This is a systemd *template* unit, so
# every instance shares one packaged unit file and is addressed by number:
#
#     sudo /usr/lib/insight-hub/collector/add-collector.sh 2
#     sudo systemctl status insight-hub-collector@2
#
# The script creates /etc/insight-hub/collector2/, assigns port 3000 + N,
# and enables the instance. Instances coordinate through the server: each claims
# a distinct batch of jobs under its own instance id, so two collectors never
# process the same mailbox. Nothing here needs to change when you add more.
# ============================================================================

NODE_ENV=production
LOG_LEVEL=info

# Local health endpoint. Each instance must use a different port —
# convention: instance N listens on 3000 + N.
PORT=3001

# How this collector identifies itself to the server, in the collector list and
# on the jobs it claims. Leave blank and it becomes <hostname>:<PORT>, which is
# unique and — importantly — the same after every restart.
#
# It used to include the process id, so each restart arrived as a brand-new
# collector and the server's list filled with duplicates of the same machine: one
# alive, the rest stuck at "offline" until they aged out an hour later. Set this
# explicitly only if two machines could share a hostname.
COLLECTOR_INSTANCE_ID=

# ── Server connection ────────────────────────────────────────────────────────
# Normally supplied by secrets.env, which overrides this. The value here is the
# fallback for a collector on the same machine as the server.
SERVER_URL=http://127.0.0.1:8080

# ── Throughput ───────────────────────────────────────────────────────────────
# How often to ask for work, and how many mailboxes to process at once.
# Lower the concurrency on a small VM; add instances rather than raising it far.
POLL_INTERVAL_MS=30000
WORKER_CONCURRENCY=10

LOG_PATH=/var/log/insight-hub
