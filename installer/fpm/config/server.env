# ============================================================================
# Insight Hub — SERVER configuration  (.deb / .rpm)
#
# Installed to:  /etc/insight-hub/server/.env
# Edit as root, then restart the service:
#     sudo systemctl restart insight-hub
#
# THIS FILE IS A PACKAGE CONFIGURATION FILE (dpkg conffile / rpm
# %config(noreplace)). Your edits survive upgrades. If the shipped default ever
# changes, dpkg asks what to do and rpm leaves the new version beside it as
# .rpmnew — in both cases your file is never silently replaced.
#
# ── WHERE ARE THE SECRETS? ───────────────────────────────────────────────────
# Not here. JWT_SECRET, OIDC_ENCRYPTION_KEY and COLLECTOR_SECRET are generated
# per machine at install time and written to
#
#     /etc/insight-hub/server/secrets.env      (root:email-intel 0640)
#
# which the systemd unit loads with EnvironmentFile=. Anything set there wins
# over this file, because dotenv does not override variables that are already
# in the environment.
#
# Two reasons for the split:
#   * this file stays byte-identical to what the package shipped, so upgrades
#     never stop to ask about a "modified" configuration file that only the
#     installer modified;
#   * the secrets file is not owned by the package, so `apt purge` removes it
#     and a reinstall regenerates it rather than resurrecting an old key.
#
# To pin your own value for any of them, either edit secrets.env or set the key
# here — a key set here still applies when secrets.env does not define it.
# ============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ── Web + API ────────────────────────────────────────────────────────────────
# One port serves both the REST API and the web interface.
#
# Ports below 1024 need extra privilege: this runs as a non-root user, so to
# serve on 80 or 443 either put a reverse proxy in front (recommended) or grant
# the binary the capability:
#     sudo setcap 'cap_net_bind_service=+ep' /usr/bin/insight-hub-server
# Note that setcap is undone by every package upgrade, which replaces the file.
PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# The one value most installations need to change. The database is created and
# migrated automatically on first start when the user holds CREATEDB.
# Percent-encode special characters in the password:  @ = %40, : = %3A, / = %2F
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/insight_hub

# ── First administrator ──────────────────────────────────────────────────────
# Created on first start, since the package asks for nothing. The account opens
# in the first-login setup screen, where the operator sets a real password and
# creates the organisation.
# CHANGE THIS PASSWORD before distributing the package.
SEED_DEFAULT_ADMIN=true
SEED_ADMIN_EMAIL=admin@insight-hub.local
SEED_ADMIN_PASSWORD=ChangeMe@2026!

# ── Paths ────────────────────────────────────────────────────────────────────
# FHS locations. The unit's ProtectSystem=strict makes the rest of the disk
# read-only to this process, so writable paths must stay under these two.
UPLOAD_PATH=/var/lib/insight-hub/uploads
BACKUP_PATH=/var/lib/insight-hub/backups
LOG_PATH=/var/log/insight-hub

# ── Collector ────────────────────────────────────────────────────────────────
# Where the server sends on-demand sync triggers. With several collectors this
# points at the first one; the others pull work on their own.
COLLECTOR_URL=http://127.0.0.1:3001

# ── Same-origin UI ───────────────────────────────────────────────────────────
# The interface is served by this process, so it only needs to trust itself.
# Add other origins only if you put a reverse proxy in front.
CORS_ORIGIN=http://localhost:8080
