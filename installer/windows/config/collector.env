# ============================================================================
# Insight Hub — COLLECTOR configuration  (instance 1)
#
# Installed to:  <InstallDir>\config\collector1\.env
# Restart after editing:
#     net stop InsightHubCollector1 & net start InsightHubCollector1
#
# The collector pulls mailbox sync jobs from the server and ingests mail from
# Microsoft 365 / Google Workspace. It only listens on a local /health endpoint;
# all real traffic is outbound, so its port is never opened in the firewall.
#
# ── RUNNING MORE COLLECTORS ──────────────────────────────────────────────────
# Throughput scales by adding instances. Each needs its own config folder, its
# own PORT and its own Windows service. The installer ships a script that does
# all three:
#
#     cd "C:\Program Files\InsightHub\scripts"
#     .\add-collector.ps1 -Instance 2
#
# It copies SERVER_URL and COLLECTOR_SECRET from this file, assigns port
# 3001 + (instance - 1), and registers InsightHubCollector2.
#
# Instances coordinate through the server: each claims a distinct batch of jobs
# using its own instance id, so two collectors never process the same mailbox.
# Nothing here needs to change when you add more.
# ============================================================================

NODE_ENV=production
LOG_LEVEL=info

# Local health endpoint. Each instance must use a different port —
# convention: instance N listens on 3000 + N.
PORT=3001

# How this collector identifies itself to the server, in the collector list and
# on the jobs it claims. Leave blank and it becomes <hostname>:<PORT>, which is
# unique and — importantly — the same after every restart.
#
# It used to include the process id, so each restart arrived as a brand-new
# collector and the server's list filled with duplicates of the same machine: one
# alive, the rest stuck at "offline" until they aged out an hour later. Set this
# explicitly only if two machines could share a hostname.
COLLECTOR_INSTANCE_ID=

# ── Server connection ────────────────────────────────────────────────────────
# Must match the server's PORT. Point at another host to run this collector on
# a separate machine — then copy COLLECTOR_SECRET across by hand.
SERVER_URL=http://127.0.0.1:8080

# MUST be byte-identical to COLLECTOR_SECRET in config\server\.env. The
# installer copies it in; if the two ever differ, every poll is rejected with
# 401 and no mail is collected.
COLLECTOR_SECRET=CHANGE_ME

# ── Throughput ───────────────────────────────────────────────────────────────
# How often to ask for work, and how many mailboxes to process at once.
# Lower the concurrency on a small VM; add instances rather than raising it far.
POLL_INTERVAL_MS=30000
WORKER_CONCURRENCY=10

LOG_PATH=__INSTALLDIR__\logs
