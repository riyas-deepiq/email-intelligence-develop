# ============================================================================
# Insight Hub — SERVER configuration
#
# Installed to:  <InstallDir>\config\server\.env
# Edit with an elevated editor, then restart the service:
#     net stop InsightHub & net start InsightHub
#
# Upgrades never overwrite this file. The shipped defaults are kept beside it
# as .env.default so you can diff after an upgrade.
#
# Placeholders resolved once, during installation:
#   __INSTALLDIR__   the folder chosen on the installer's first page
#   CHANGE_ME        a per-machine secret generated at install time
# ============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ── Web + API ────────────────────────────────────────────────────────────────
# One port serves both the REST API and the web interface. The installer opens
# it for inbound TCP and points the shortcuts at it.
PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# The one value most installations need to change. The database is created and
# migrated automatically on first start when the user holds CREATEDB.
# Percent-encode special characters in the password:  @ = %40, : = %3A, / = %2F
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/insight_hub

# ── Secrets (generated per machine at install time) ──────────────────────────
# Leave as CHANGE_ME to get unique values on every installation. Pin a real
# value only if several nodes must share it.
#   JWT_SECRET           signs access tokens
#   OIDC_ENCRYPTION_KEY  encrypts stored OAuth secrets (64 hex chars; changing
#                        it makes previously stored secrets unreadable)
#   COLLECTOR_SECRET     authenticates every collector; copied into each
#                        collector's own .env by the installer
JWT_SECRET=CHANGE_ME
OIDC_ENCRYPTION_KEY=CHANGE_ME
COLLECTOR_SECRET=CHANGE_ME

# ── First administrator ──────────────────────────────────────────────────────
# Created on first start, since the installer asks for nothing. The account
# opens in the first-login setup screen, where the operator sets a real
# password and creates the organisation.
# CHANGE THIS PASSWORD before distributing the installer.
SEED_DEFAULT_ADMIN=true
SEED_ADMIN_EMAIL=admin@insight-hub.local
SEED_ADMIN_PASSWORD=ChangeMe@2026!

# ── Paths ────────────────────────────────────────────────────────────────────
UPLOAD_PATH=__INSTALLDIR__\data\uploads
BACKUP_PATH=__INSTALLDIR__\data\backups
LOG_PATH=__INSTALLDIR__\logs

# ── Collector ────────────────────────────────────────────────────────────────
# Where the server sends on-demand sync triggers. With several collectors this
# points at the first one; the others pull work on their own.
COLLECTOR_URL=http://127.0.0.1:3001

# ── Same-origin UI ───────────────────────────────────────────────────────────
# The interface is served by this process, so it only needs to trust itself.
# Add other origins only if you put a reverse proxy in front.
CORS_ORIGIN=http://localhost:8080
