# ============================================================================
# Insight Hub — CLIENT (web interface) configuration
#
# Installed to:  <InstallDir>\config\client\.env
# Restart the server service after editing:
#     net stop InsightHub & net start InsightHub
#
# HOW THIS WORKS — worth reading before you add settings.
#
# The interface is a compiled single-page application: its build-time settings
# are baked into the JavaScript and cannot be changed by editing a file next to
# it. So the server reads THIS file at startup and hands the values to the
# browser as `window.__INSIGHT_HUB_CONFIG__`, injected into the page before the app
# loads. That makes these values genuinely editable after installation.
#
# Consequences:
#   * A key added here reaches the browser. It changes behaviour only once the
#     interface reads it — treat unknown keys as inert, not broken.
#   * Never put a secret here. Everything in this file is public to anyone who
#     opens the page.
#   * The API address is deliberately NOT configurable: the interface is served
#     from the server's own origin and always calls it relatively. Change the
#     server's PORT instead.
# ============================================================================

# ── Branding ─────────────────────────────────────────────────────────────────
# Shown in the browser tab and on the sign-in screen.
APP_NAME=Insight Hub
COMPANY_NAME=RZDigital.net

# ── Support links ────────────────────────────────────────────────────────────
# Surfaced in the interface footer. Leave blank to hide a link.
SUPPORT_URL=
PRIVACY_URL=

# ── Session behaviour ────────────────────────────────────────────────────────
# Minutes of inactivity before the interface warns about signing out. The
# server enforces real token lifetimes; this only drives the warning.
IDLE_WARNING_MINUTES=25

# ── Display ──────────────────────────────────────────────────────────────────
# Default rows per page in message and thread lists.
DEFAULT_PAGE_SIZE=25
