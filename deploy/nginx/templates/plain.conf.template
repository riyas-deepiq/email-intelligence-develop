# INSIGHT_HUB_TLS_MODE=off: HTTP only, no certificate involved.
#
# For a lab, or for a node that already sits behind a corporate TLS terminator.
# Never for a production edge: logins, JWTs and OAuth tokens would cross the
# network in clear text (docs/05-security-design.md).

upstream insight-hub_server {
    server ${INSIGHT_HUB_UPSTREAM};
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml font/woff2;

    include /etc/nginx/insight-hub-locations.conf;
}
