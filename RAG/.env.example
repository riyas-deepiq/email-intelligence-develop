# =============================================================================
# .env.example — Copy to .env and fill in your values
# =============================================================================

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Collection names — rarely need changing.
COLLECTION_BODIES=email_bodies
COLLECTION_ATTACHMENTS=email_attachments
# Embedding dimension — must match the embedding model's actual output size
# (nomic-embed-text = 768). Changing embedding models without updating this
# will error on upsert.
VECTOR_SIZE=768

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=1200

# Models
EMBED_MODEL_NAME=nomic-embed-text
OLLAMA_MODEL=llama3.2

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# MUST be the same database the Core Server writes emails into (server/.env's
# DATABASE_URL) — RAG reads the `messages` table directly for ingestion.
#
#   ⚠️ The two services spell the SAME connection differently:
#        server/.env  DATABASE_URL=postgres://USER:PASS@HOST:5432/insight_hub
#        RAG/.env     POSTGRES_URL=postgresql+psycopg2://USER:PASS@HOST:5432/insight_hub
#                                  ^^^^^^^^^^^^^^^^^^^^ SQLAlchemy needs the driver name
#   Only the scheme differs. USER, PASS, HOST, PORT and the DATABASE NAME must
#   match exactly.
#
#   Pointing this at the wrong database FAILS SILENTLY in the worst way: the
#   default maintenance DB ("postgres") has no `messages` table, so ingestion
#   indexes nothing and chat answers "no emails found" while every service
#   still reports healthy. Run `python scripts/check_system.py` to catch it.
POSTGRES_URL=postgresql+psycopg2://user:password@localhost:5432/insight_hub

# ── Redis (for Celery task queue) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Data paths ───────────────────────────────────────────────────────────────
# Extracted attachment files are saved here — only used by the manual /upload
# single-.eml endpoint (the Postgres bulk path never has attachment bytes).
ATTACHMENTS_FOLDER=./data/attachments

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=50
EMBED_BATCH_SIZE=4
# Body text is trimmed to this many characters before chunking (per email).
MAX_BODY_CHARS=100000

# ── Ingestion concurrency ──────────────────────────────────────────────────────
# Emails processed concurrently during ingest_from_postgres() (chunk/embed/
# upsert per email). Override with --workers on the CLI script. Don't set
# much higher than Ollama's own OLLAMA_NUM_PARALLEL (default 4) — extra
# workers beyond that just queue on Ollama's side without added throughput.
INGEST_MAX_WORKERS=4

# ── Retrieval ────────────────────────────────────────────────────────────────
TOP_K_RESULTS=3
RERANK_TOP_K=5
HYBRID_TOP_K=20
SCORE_THRESHOLD=0.3

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Internal service-to-service auth ──────────────────────────────────────────
# Shared secret guarding /api/v1/query/* — set the SAME value here and as
# RAG_API_SECRET in the Core Server's .env. FAIL-CLOSED: if this is blank the
# query API returns 503 rather than serving unauthenticated requests, because
# /query/* scopes results purely by the caller-supplied mailbox_ids list.
RAG_INTERNAL_SECRET=
# Local dev only — allows /query/* to run with no secret set. Never enable this
# anywhere the port is reachable from another machine.
RAG_ALLOW_INSECURE_INTERNAL=false

# ── Core Server (for attachment vectorization) ────────────────────────────────
# Internal HTTP URL of the Core Server, used to fetch attachment bytes on
# demand during attachment ingestion (attachments are metadata-only in
# Postgres — bytes live with the mail provider). Reuses RAG_INTERNAL_SECRET
# above as the Bearer token against the Core Server's /v1/rag-internal/*
# (must match its RAG_API_SECRET).
CORE_SERVER_URL=http://127.0.0.1:3000
