# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_ to the app.

# Base URL of the Core Server API.
#   Default (if unset): http://localhost:3000/api/v1
#   In dev you can also rely on the Vite proxy (/api -> http://localhost:3000).
VITE_API_URL=http://localhost:3000/api/v1
VITE_SUPPORT_EMAIL=support@insight-hub.local
