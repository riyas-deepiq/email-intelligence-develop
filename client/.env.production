# Production build settings — used by `vite build` (Vite loads .env.production
# after .env, so this overrides the developer's local .env).
#
# The packaged server serves this bundle from its own origin and port
# (docs/packaging-design.md §0C), so the API base MUST be relative. An absolute
# URL would be inlined into the JS at build time and every installed copy would
# call the machine where it was BUILT — which is how a shipped build ended up
# talking to http://localhost:3000.
#
# Must stay a non-empty path: the code falls back to '/api/v1' only when the var
# is undefined, and an empty string would resolve requests against the site root.
VITE_API_URL=/api/v1
VITE_SUPPORT_EMAIL=support@insight-hub.local
