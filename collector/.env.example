# ─────────────────────────────────────────────────────────────────────────────
# Insight Hub — Collector environment
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode
NODE_ENV=development

# Health endpoint port (no public inbound traffic needed — monitoring only)
PORT=3001

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Server connection ─────────────────────────────────────────────────────────
# Base URL of the Server API. In production point this at Nginx (load balanced).
# The collector sends ALL traffic here — never directly to Postgres or Redis.
SERVER_URL=http://localhost:3000

# Shared secret for collector ↔ server auth.
# Sent as: Authorization: Bearer <COLLECTOR_SECRET>
# Must match the server's COLLECTOR_SECRET env var.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
COLLECTOR_SECRET=dev-collector-secret

# ── Tuning ────────────────────────────────────────────────────────────────────
# How often to poll the server for new jobs (milliseconds). Also acts as the
# heartbeat interval — server tracks last_seen per collector instance.
POLL_INTERVAL_MS=30000

# Max mailboxes processed in parallel per collector instance.
WORKER_CONCURRENCY=10

# Per-job liveness heartbeat: while a job is in flight the worker re-sends
# {status:'running'} at this interval so the server knows the worker is alive.
# Must stay well under the server's 10-minute stale-running sweep threshold.
JOB_HEARTBEAT_MS=120000

# Buffer flush triggers (per mailbox worker — whichever hits first):
FLUSH_MAX_MESSAGES=50   # flush after this many messages
FLUSH_MAX_SIZE_MB=50    # flush after this many MB
FLUSH_MAX_AGE_MS=10000  # flush after 10 seconds
